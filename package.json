{
  "name": "spaghetti-meter",
  "version": "0.1.1",
  "description": "A playful desktop meter for repository spaghetti",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run licenses:generate && vite build",
    "preview": "vite preview",
    "prepare": "npm run prepare:sidecar",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "version:check": "node scripts/check-versions.mjs",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "tauri": "tauri"
  },
  "config": {
    "codeBusterVersion": "0.14.3"
  },
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.0.0-b716d37-20260925",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@pixi/ui": "^2.4.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "2.5.5",
    "gifenc": "^1.0.3",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spagetti",
  "version": "0.1.0",
  "identifier": "dev.toolbunker.spagetti",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:sidecar && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Spagetti — project mess meter",
        "width": 540,
        "height": 900,
        "minWidth": 420,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/cb"],
    "resources": ["resources/code-buster-LICENSE.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
